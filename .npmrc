# Supply-chain hardening (added 2026-05-12): 24h cooldown blocks same-day-published versions.
# Defends against Mini Shai-Hulud-style npm worms that get caught/unpublished within hours.
minimumReleaseAge=1440

# React 19 peer conflict in @usewaypoint email-builder blocks (email-area team to resolve properly)
legacy-peer-deps=true
